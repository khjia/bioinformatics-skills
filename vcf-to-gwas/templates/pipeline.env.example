# pipeline.env.example ---- copy to pipeline.env and edit
# then: set -a; source pipeline.env; set +a; bash run_all.sh

PROJECT=/path/to/project

# --- VCF / QC ---
VCF=$PROJECT/dataset3.recode.vcf
THREADS=16
GENO=0.2          # per-variant missingness filter
MAF=0.05
PRUNE_WIN=50      # indep-pairwise window (SNPs)
PRUNE_STEP=10
PRUNE_R2=0.2
NPC=3             # PCs written to PCA.csv (10 computed)

# --- GWAS ---
TRAITS=all        # or "fa_C24_1,fa_C22_1"
SVRAD=20
SVPAL=0.01
SVMLOD=3

# --- tools ---
RSCRIPT=/path/to/Rscript
PY=python3
